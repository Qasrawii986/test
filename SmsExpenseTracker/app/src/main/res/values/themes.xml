<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmsExpenseTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Used by the UI-less quick-launch trampoline so nothing flashes on screen. -->
    <style name="Theme.SmsExpenseTracker.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
